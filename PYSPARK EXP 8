# Create the CSV file
csv_data = """Name,Age,Salary,Department
Arjun,25,45000,IT
Neha,28,55000,HR
Rohan,30,65000,IT
Pooja,26,50000,Finance
Karan,32,70000,Finance
Meera,29,60000,HR"""

with open("employees.csv", "w") as f:
    f.write(csv_data)

# Import PySpark modules
from pyspark.sql import SparkSession
from pyspark.sql.functions import avg, max, min

# Start Spark session
spark = SparkSession.builder \
    .appName("Employee Data Analysis") \
    .master("local[*]") \
    .getOrCreate()

# Read CSV
df = spark.read.csv("employees.csv", header=True, inferSchema=True)

# Run operations
df.show()
df.printSchema()
print("Number of employees:", df.count())

df.select("Name", "Salary").show()
df.filter(df.Salary > 55000).show()

df.select(avg("Salary").alias("Average_Salary")).show()
df.select(max("Salary").alias("Maximum_Salary")).show()
df.select(min("Salary").alias("Minimum_Salary")).show()

df.groupBy("Department").agg(avg("Salary").alias("Average_Salary")).show()
df.orderBy("Salary", ascending=False).show()
df.groupBy("Department").count().show()

# Stop the session
spark.stop()